# ============================================================================
# Treasury Market Health Monitor ("The Canary") — backend config
# Copy to backend/.env. Core runs on FREE public APIs; only FRED needs a key.
# ============================================================================

# --- FRED (backbone — free key at fredaccount.stlouisfed.org/apikeys) ---------
# Without it, curve/rates/recession metrics show STALE; keyless sources still run.
# FRED_API_KEY=

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/canary.db

# --- Optional -----------------------------------------------------------------
# FMP_API_KEY=               # enables gold (GLD) in the "Where is the money going?" flow compass
# MOVE_API_KEY=              # licensed ICE MOVE override (else a labeled proxy is used)
# ALERT_WEBHOOK_URL=         # POST target fired on regime-change events (re-steepening etc.)

# --- HTTP / caching ----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# --- Scheduling --------------------------------------------------------------
RUN_SCHEDULER=true
REFRESH_INTERVAL_MINUTES=720
BACKFILL_ON_STARTUP=true

# --- Display -----------------------------------------------------------------
DISPLAY_TZ=America/Puerto_Rico   # storage is always UTC

# --- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
# THRESHOLDS_FILE=./config/thresholds.json   # override any green/yellow/red cutoff
