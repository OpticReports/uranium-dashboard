{
  "name": "treasury-canary-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "smoke:aidebt": "esbuild scripts/aidebt_smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --alias:recharts=./scripts/recharts_shim.tsx --define:import.meta.env.DEV=false --define:import.meta.env.VITE_API_BASE='\"\"' --outfile=node_modules/.cache/aidebt_smoke.cjs --log-level=warning && node node_modules/.cache/aidebt_smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
