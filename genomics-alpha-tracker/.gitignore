# Secrets
.env
backend/.env
frontend/.env

# Data / cache (SQLite + per-API cache). `backend/data/*` (not `backend/data/`)
# so the compiled point-in-time catalyst store and backtest result rows CAN be
# tracked — the raw pit_ctgov_cache/ (thousands of CT.gov responses) stays out.
backend/data/*
!backend/data/pit_catalysts.json
!backend/data/backtest_calls_10y_results.json
!backend/data/backtest_variants_10y_results.json
!backend/data/backtest_variants_r2_results.json
!backend/data/backtest_variants_r3_results.json
!backend/data/backtest_core_variants_results.json
!backend/data/backtest_sleeve_variants_r5_results.json
# the FROZEN R2-A daily dollar curve — an INPUT the round-4 harness
# reuses verbatim, so it has to be tracked or the campaign is not
# reproducible from a clean checkout
!backend/data/r2a_daily.json
# R2-A's daily equity AND invested notional, rebuilt from the round-2
# pipeline (scripts/build_r2a_exposure.py). The idle CAPITAL fraction is
# what C7 routes; without this file the correction is not reproducible.
!backend/data/r2a_exposure.json
!backend/data/bil_bars_raw.json
*.db
*.sqlite3

# Node / frontend
node_modules/
frontend/dist/

# OS / editor
.DS_Store
.idea/
.vscode/
