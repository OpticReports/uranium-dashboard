# Frontend env (Vite). Only needed if NOT using the nginx/compose proxy.
# In docker-compose, nginx proxies /api -> backend, so leave this unset.
# For bare-metal dev, the Vite proxy (vite.config.js) handles /api -> :8000.

# Point the SPA directly at a backend origin (overrides the /api proxy):
# VITE_API_BASE=http://localhost:8000

# Target the dev proxy forwards to (default http://localhost:8000):
# VITE_API_TARGET=http://localhost:8000
