# ============================================================================
# Genomics Sector Alpha Tracker — backend configuration
# Copy to `.env`. EVERY key here is OPTIONAL: the system runs fully on the free
# yfinance baseline. Modules missing a key log a warning and skip — never crash.
# ============================================================================

# --- Storage -----------------------------------------------------------------
# SQLite by default. For Postgres (clean upgrade path):
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/genomics
DATABASE_URL=sqlite:///./data/genomics.db

# --- Market-data provider ----------------------------------------------------
# yfinance (default, NO KEY) | polygon | fmp | tiingo
MARKET_PROVIDER=yfinance
# Premium feeds materially improve options IV/skew, short interest, and intraday
# quality for thin-float names (ALMR, GENB, QSI, MASS). Set the provider above
# AND the matching key below to enable.
# POLYGON_API_KEY=
# FMP_API_KEY=          # also powers the analyst layer (estimates/price targets)
# TIINGO_API_KEY=

# --- Analyst layer -----------------------------------------------------------
# fmp (uses FMP_API_KEY) | yfinance (free fallback: upgrades/downgrades only)
ANALYST_PROVIDER=fmp

# --- Social / hype layer -----------------------------------------------------
# Primary source is ApeWisdom: FREE, no key, aggregates ~15 stock subreddits and
# returns REAL daily mention counts (hundreds for active names) — far more robust
# than the keyless StockTwits endpoint (which caps at ~30 msgs and 403s on cloud
# IPs). FMP social adds StockTwits+Twitter history using your FMP key (best-effort:
# it's a legacy endpoint some tiers block). X/Twitter still REQUIRES a PAID tier.
APEWISDOM_ENABLED=true    # free, no key — robust Reddit mention counts
FMP_SOCIAL_ENABLED=true   # uses FMP_API_KEY; skipped silently if your tier 403s it
# --- X / Twitter posts -------------------------------------------------------
# Two routes (X_BEARER_TOKEN wins if both set):
#   * X_BEARER_TOKEN — official X API, pay-per-use, ToS-clean (pricey at scale).
#   * TWITTERAPI_IO_KEY — twitterapi.io, ~97% cheaper $TICKER post search. Spend is
#     bounded by MAX_POSTS x LOOKBACK x scheduler cadence (3rd-party / X-ToS gray).
# X_BEARER_TOKEN=
# TWITTERAPI_IO_KEY=
TWITTERAPI_IO_MAX_POSTS=50      # cap posts pulled per symbol per run (bounds cost)
TWITTERAPI_IO_LOOKBACK_DAYS=2   # only pull posts from the last N days
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=genomics-alpha-tracker/0.1
STOCKTWITS_ENABLED=true   # public endpoint, no key (rate-limited, best-effort)

# --- Sentiment engine --------------------------------------------------------
# lexicon (default, NO KEY) | anthropic (higher quality, costs per call)
SENTIMENT_ENGINE=lexicon

# --- Chat analyst (grounded LLM over your data) ------------------------------
# Set ANTHROPIC_API_KEY to enable the "Analyst Chat" tab. The agent answers
# investment questions by calling tools that pull your real Alpha data + live
# FMP valuation (works for any ticker), then writes a structured trade memo.
# Without this key the chat tab shows a "disabled" notice; everything else runs.
# ANTHROPIC_API_KEY=
# Default model (fast/cheap) and the "Deep analysis" toggle model:
CHAT_MODEL_DEFAULT=claude-sonnet-4-6
CHAT_MODEL_DEEP=claude-opus-4-8

# --- Science layer -----------------------------------------------------------
# Optional NCBI key raises PubMed rate limits (3/s -> 10/s).
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com

# --- Caching / HTTP ----------------------------------------------------------
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=30

# --- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RUN_SCHEDULER=true
LOG_LEVEL=INFO
