ire/next_open target=0.3 int=True clip=True comm=ibkr_fixed bil$=True carry=True", "selection": {"per_symbol_max": 2, "symbol_release": "cap", "n_gated": 3059, "entries_taken": 645, "refused_repeat": 204, "skipped_at_cap": 2210, "refused_exit_date_boundary_only": 10, "refused_by_same_gate_date_sibling": 4, "book_entries": 641, "skipped_zero_qty": 4, "days_at_cap": 593}, "concentration": {"basis": "book held (entry_date <= d < exit_date); share = symbol MTM / sleeve_eq at the close; open days = >= 1 held", "n_open_days": 1935, "largest_name_share_p50": 0.16628, "largest_name_share_p90": 0.2753, "largest_name_share_max": 0.51918, "mean_distinct_names_per_open_day": 5.50233, "max_same_name_held": 2}, "mean_r_net_taken": 0.18441, "carry_usd": 11467.44841, "commissions_paid": 4076.35, "vs_a0": {"deltas": {"full": {"cagr": -0.0002, "max_dd": -0.0025, "sharpe": 0.02199, "end_value": -913.34641, "longest_underwater_days": -1}, "5y": {"cagr": 0.004, "max_dd": -0.0053, "sharpe": 0.03682, "end_value": -913.34641, "longest_underwater_days": -1}, "2y": {"cagr": -0.00024, "max_dd": -0.00041, "sharpe": 0.0103, "end_value": -913.34641, "longest_underwater_days": -72}}, "point_sharpe_delta_full": 0.02199, "sharpe_delta_bootstrap": {"draws": 10000, "mean_block_days": 21, "seed": 20261006, "n_days": 2671, "p2_5": -0.08092, "p50": 0.02672, "p97_5": 0.11368, "bonf_family": 2, "bonf_lo": -0.09728, "bonf_hi": 0.12439, "excludes_zero": false, "p5": -0.0619, "p95": 0.10026}, "sharpe_delta_bootstrap_block63": {"draws": 10000, "mean_block_days": 63, "seed": 20261006, "n_days": 2671, "p2_5": -0.08642, "p50": 0.02744, "p97_5": 0.11953, "bonf_family": 2, "bonf_lo": -0.10256, "bonf_hi": 0.13325, "excludes_zero": false, "p5": -0.06694, "p95": 0.10377}, "p90_share_delta": -0.12411, "sleeve_twr_deltas": {"full": {"cagr": -0.01031, "max_dd": -0.00248, "sharpe": 0.00796}, "5y": {"cagr": 0.01681, "max_dd": -0.04393, "sharpe": 0.101}, "2y": {"cagr": -0.00093, "max_dd": -0.00356, "sharpe": 0.02977}}, "sleeve_twr_sharpe_delta_bootstrap": {"draws": 10000, "mean_block_days": 21, "seed": 20261006, "n_days": 2671, "p2_5": -0.21145, "p50": 0.0175, "p97_5": 0.22655, "bonf_family": 2, "bonf_lo": -0.24526, "bonf_hi": 0.25045, "excludes_zero": false, "p5": -0.17466, "p95": 0.19389}}, "decision": {"decision": "PROPOSE", "tier": "risk_control", "reasons": {"tier1_improvement": {"bonf2_lo_gt_0": false, "max_dd_within_2pp_of_a0": true, "sharpe_delta_5y_gt_0": true}, "tier2_risk_control": {"p5_ge_minus_0.10": true, "max_dd_within_0.5pp_of_a0": true, "sharpe_delta_5y_ge_minus_0.05": true, "p90_share_10pp_below_a0": true}}}, "sensitivity_live_release": {"symbol_release": "live", "selection": {"per_symbol_max": 2, "symbol_release": "live", "n_gated": 3059, "entries_taken": 654, "refused_repeat": 193, "skipped_at_cap": 2212, "refused_exit_date_boundary_only": 0, "refused_by_same_gate_date_sibling": 4}, "book_full": {"start": "2016-01-04", "end": "2026-08-19", "end_value": 499675.80227, "cagr": 0.14379, "max_dd": 0.27996, "sharpe": 0.98444, "sortino": 1.38647, "calmar": 0.51363}, "book_5y": {"start": "2021-08-19", "end": "2026-08-19", "end_value": 499675.80227, "cagr": 0.12168, "max_dd": 0.19873, "sharpe": 0.87996, "sortino": 1.28432, "calmar": 0.61228}, "point_sharpe_delta_full": 0.01723, "sharpe_delta_5y": 0.02438, "max_dd_delta": -0.00238, "largest_name_share_p90": 0.27672, "p90_share_delta": -0.12269, "sharpe_delta_bootstrap": {"draws": 10000, "mean_block_days": 21, "seed": 20261006, "n_days": 2671, "p2_5": -0.08696, "p50": 0.02211, "p97_5": 0.11032, "bonf_family": 2, "bonf_lo": -0.10387, "bonf_hi": 0.12101, "excludes_zero": false, "p5": -0.06853, "p95": 0.09658}, "decision": {"decision": "PROPOSE", "tier": "risk_control", "reasons": {"tier1_improvement": {"bonf2_lo_gt_0": false, "max_dd_within_2pp_of_a0": true, "sharpe_delta_5y_gt_0": true}, "tier2_risk_control": {"p5_ge_minus_0.10": true, "max_dd_within_0.5pp_of_a0": true, "sharpe_delta_5y_ge_minus_0.05": true, "p90_share_10pp_below_a0": true}}}}}}, "decisions": {"U1": {"decision": "NULL", "tier": null}, "U2": {"decision": "PROPOSE", "tier": "risk_control"}}, "proposal": {"proposal": "U2", "rule": "single qualifying arm", "live_port_spec": "ibkr-executor blend.py step(): held_by_symbol(sym) = positions in sym NOT in `exiting` + pending_entries in sym + entry_intents in sym ALREADY PLANNED THIS CYCLE; refuse an intent when held_by_symbol >= k, checked AFTER the cap check (a refusal consumes no slot), walking the payload in (gate_date, entry_date, symbol, flag) order. Required gate test: two same-symbol fires (different flags) in ONE payload -> k=1 plans the first only (the replay refuses same-gate-date siblings; counter-agent A2). Live frees an exiting / stop-filled call in the same cycle; the replay holds it through its exit date (see sensitivity_live_release) \u2014 pin one semantics in the port and its test."}, "honesty": ["In-sample over the same 10.6 years as every prior round (2016-01-04..2026-08-19); a per-symbol winner here is a hypothesis, not a result. Never present these in-sample CAGRs as a forecast.", "Survivor-shaped fire set (today's watchlist); the fire rate is taken as given; the tracker's repeat-fire behaviour is whatever it was historically.", "Costs: IBKR fixed schedule + tiered slippage; BIL carry is the realised BIL total return.", "A pass changes the executor's planner only (the tracker keeps publishing every gated fire); the shadow grader and H14 are unaffected.", "MEASUREMENT BASIS: daily mark-to-market on adjusted closes; max DD on the daily curve; CAGR calendar-day (365.25); Sharpe sqrt(252), rf = 0; 5y/2y are SLICES of the full curve, not restarted books.", "Paired Sharpe-delta intervals are CONDITIONAL on this single in-sample path: percentile, not bias-corrected; 21-day blocks understate regime persistence (63-day sensitivity reported). p5 is the 5th percentile of the SAME draws (one-sided 95% lower bound).", "Max DD and the concentration p90 carry no interval: single-path point comparisons.", "Per-symbol 'open' in the SELECTION uses the cap's occupancy (gate date .. exit date inclusive); the CONCENTRATION metrics use the book's held definition (entry_date <= d < exit_date) and the symbol's MTM notional / sleeve equity at the close, so a U1 name can still show one position.", "Selection counts: the cap is checked first; refused_repeat counts only repeats that would otherwise have taken a slot (a repeat arriving at a full cap is skipped_at_cap).", "Sleeve CAGR / max DD / Sharpe are TIME-WEIGHTED: each day's band transfer to/from the core (run_executor_book's sleeve_band_flow, incl. the BIL fee on a sleeve->core move) is an external flow, r_t = (sleeve_eq_t - flow_t) / sleeve_eq_{t-1} - 1. The sleeve BUCKET incl. transfers (round 10's convention) is kept as 'sleeve_bucket_incl_transfers' and is NOT a return. The decision rule is book-level.", "Sanity reproduction: the motivating '258 entries into an open name' counts same-day co-entries both ways (entry_date <= d < exit_date of ANY other trade); the first/repeat R split (440/234) uses strictly-earlier entries. Both definitions are recorded as the scratch computed them.", "Tie-break per contract: both arms qualifying -> higher full-window point Sharpe delta, tie -> U1; the comparison is across tiers too, as written.", "Sleeve, time-weighted vs bucket incl. transfers (full window): A0 TWR CAGR 11.5% / DD 29.8% / Sh 0.636 vs bucket 13.8% / 28.1% (net transfer in $+11,215 over 6 days); U1 TWR CAGR 7.3% / DD 28.5% / Sh 0.525 vs bucket 14.5% / 28.3% (net transfer in $+47,146 over 11 days); U2 TWR CAGR 10.4% / DD 29.6% / Sh 0.644 vs bucket 13.8% / 32.4% (net transfer in $+13,096 over 10 days). The bucket figures are NOT returns (counter-agent B1).", "U1 sleeve TWR CAGR -4.2 pp/yr vs A0 (7.3% vs 11.5%), sleeve TWR Sharpe delta point -0.110 (paired p50 -0.104, p5 -0.403); book Sharpe delta -0.009, book CAGR delta -0.87 pp/yr \u2014 the book does NOT stay level (re-review N1).", "U2 sleeve TWR CAGR -1.0 pp/yr vs A0 (10.4% vs 11.5%), sleeve TWR Sharpe delta point +0.008 (paired p50 +0.017, p5 -0.175); book Sharpe delta +0.022, book CAGR delta -0.02 pp/yr \u2014 the book stays level through the band-rebalancing path.", "U1 per-symbol exit-date boundary: the replay holds a symbol THROUGH its exit date (the cap's test), conservative by up to one day vs live, where an exiting or stop-filled call frees the symbol in the same cycle: 39/682 refusals hinge on it. Re-run with live release: end $459,625, dSh -0.023 (vs -0.009), 5y dSh -0.042 (vs -0.052), dDD +0.28 pp (vs -1.02 pp), p5 -0.141, p90 share 20.6% -> NULL (counter-agent A1).", "U2 per-symbol exit-date boundary: the replay holds a symbol THROUGH its exit date (the cap's test), conservative by up to one day vs live, where an exiting or stop-filled call frees the symbol in the same cycle: 10/204 refusals hinge on it. Re-run with live release: end $499,676, dSh +0.017 (vs +0.022), 5y dSh +0.024 (vs +0.037), dDD -0.24 pp (vs -0.25 pp), p5 -0.069, p90 share 27.7% -> PROPOSE (risk_control) (counter-agent A1).", "Same-gate-date siblings: 159 (symbol, gate_date) groups carry >1 gated fire; refusals blocked by a same-gate-date sibling: U1 23, U2 4. A live port counting only positions + pending_entries would let these in; see proposal.live_port_spec (counter-agent A2)."]}