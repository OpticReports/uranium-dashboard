# Composer API credentials — placeholders only. NEVER put real values here.
#
# Obtain a key: Composer app > Accounts & Funding > Request an API key.
# You receive a Key ID and a Secret. Provide them to the session as
# environment variables (do NOT write real values into any tracked file):
#
#   export COMPOSER_API_KEY_ID=...
#   export COMPOSER_SECRET=...
#
# The project .mcp.json injects them into the Composer MCP server's auth
# headers at runtime via ${COMPOSER_API_KEY_ID} / ${COMPOSER_SECRET}.
COMPOSER_API_KEY_ID=your-key-id-here
COMPOSER_SECRET=your-secret-here
