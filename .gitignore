__pycache__/
*.pyc

# Secrets — Composer API credentials must NEVER be committed.
# The MCP server reads COMPOSER_API_KEY_ID / COMPOSER_SECRET from the
# environment at runtime; keep them in a local .env that stays untracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# aider's own working files. Pre-seeded so the coding agent has nothing to
# add here: its first live run edited ONLY .gitignore, which put housekeeping
# noise in every diff the gates then had to judge.
.aider*
